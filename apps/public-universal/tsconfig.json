{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "baseUrl": "../..",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@bp/api-contract": [
        "packages/ts/api-contract/src/index.ts"
      ],
      "@bp/api-contract/*": [
        "packages/ts/api-contract/*"
      ],
      "@bp/api-client-public": [
        "packages/ts/api-client-public/src/index.ts"
      ],
      "@bp/presentation-catalogue": [
        "packages/ts/presentation-catalogue/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
