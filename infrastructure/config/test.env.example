BP_ENV=test
BP_TEMP_DOMAIN_SUFFIX=preview.localhost
BP_TEMP_SITE_SCHEME=http
BP_TEMP_SITE_PORT=3015
BP_RELEASE_SHA=0000000
BP_LOG_LEVEL=INFO
BP_API_BASE_PATH=/api/v1
BP_POSTGRES_PORT=5432
BP_POSTGRES_HOST=postgres
BP_POSTGRES_DATABASE=bp_test
BP_POSTGRES_SSL_MODE=disable
BP_REDIS_CONTROL_ENDPOINT=redis://redis-control:6379/0
BP_REDIS_BROKER_ENDPOINT=redis://redis-broker:6379/0
BP_OPENSEARCH_ENDPOINT=http://opensearch:9200
BP_MEDIA_BUCKET=bp-media-test
BP_MEDIA_STAGING_PREFIX=staging/
BP_MEDIA_CDN_ORIGIN=http://minio:9000/bp-media-test
BP_SECURITY_STATE_TABLE=bp-security-state-test
BP_VAULT_ADDR=http://vault-dev:8200
BP_VAULT_ROLE=bp-test
BP_SMTP_HOST=smtp-sink
BP_SMTP_PORT=1025
BP_SERVICE_NAME=api
BP_HTTP_PORT=8080
BP_POSTGRES_POOL_MAX=20
BP_POSTGRES_SITE_CREDENTIAL_FILE=/run/secrets/bp/postgres-site
BP_POSTGRES_PLATFORM_CREDENTIAL_FILE=/run/secrets/bp/postgres-platform
BP_SMTP_CREDENTIAL_FILE=/run/secrets/bp/smtp
