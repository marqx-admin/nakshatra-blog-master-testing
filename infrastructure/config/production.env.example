BP_ENV=production
BP_RELEASE_SHA=0000000
BP_LOG_LEVEL=INFO
BP_API_BASE_PATH=/api/v1
BP_POSTGRES_PORT=5432
BP_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.production.example.invalid
BP_TRUSTED_PROXY_MODE=aws-alb
BP_POSTGRES_HOST=replace-with-production-rds.internal
BP_POSTGRES_DATABASE=bp
BP_MIGRATION_DATABASE_USER=replace-with-production-bootstrap-db-user
BP_MIGRATION_CREDENTIAL_FILE=/run/secrets/bp/migration
SITE_01_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_01
SITE_02_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_02
SITE_03_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_03
SITE_04_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_04
SITE_05_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_05
SITE_06_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_06
SITE_07_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_07
SITE_08_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_08
SITE_09_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_09
SITE_10_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_10
SITE_11_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_11
SITE_12_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_12
SITE_13_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_13
SITE_14_TIMEZONE=REPLACE_WITH_IANA_TIMEZONE_SITE_14
BP_POSTGRES_SSL_MODE=verify-full
BP_REDIS_CONTROL_ENDPOINT=rediss://replace-with-production-control-redis:6379/0
BP_REDIS_BROKER_ENDPOINT=rediss://replace-with-production-broker-redis:6379/0
BP_OPENSEARCH_ENDPOINT=https://replace-with-production-opensearch
BP_MEDIA_BUCKET=replace-with-production-private-media-bucket
BP_MEDIA_STAGING_PREFIX=staging/
BP_MEDIA_CDN_ORIGIN=https://media.example.invalid
BP_SECURITY_STATE_TABLE=replace-with-production-security-state
BP_VAULT_ADDR=https://vault.production.example.invalid
BP_VAULT_ROLE=bp-production
BP_SMTP_HOST=email-smtp.production.example.invalid
BP_SMTP_PORT=587
BP_SERVICE_NAME=api
BP_HTTP_PORT=8080
BP_POSTGRES_POOL_MAX=20
BP_POSTGRES_SITE_CREDENTIAL_FILE=/run/secrets/bp/postgres-site
BP_POSTGRES_PLATFORM_CREDENTIAL_FILE=/run/secrets/bp/postgres-platform
BP_REDIS_CONTROL_PASSWORD_FILE=/run/secrets/bp/redis-control
BP_REDIS_BROKER_PASSWORD_FILE=/run/secrets/bp/redis-broker
BP_SMTP_CREDENTIAL_FILE=/run/secrets/bp/smtp
