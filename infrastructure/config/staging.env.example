BP_ENV=staging
BP_RELEASE_SHA=0000000
BP_LOG_LEVEL=INFO
BP_API_BASE_PATH=/api/v1
BP_POSTGRES_PORT=5432
BP_OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.staging.example.invalid
BP_TRUSTED_PROXY_MODE=aws-alb
BP_POSTGRES_HOST=replace-with-staging-rds.internal
BP_POSTGRES_DATABASE=bp
BP_MIGRATION_DATABASE_USER=replace-with-staging-bootstrap-db-user
BP_MIGRATION_CREDENTIAL_FILE=/run/secrets/bp/migration
SITE_01_TIMEZONE=Asia/Kolkata
SITE_02_TIMEZONE=Asia/Kolkata
SITE_03_TIMEZONE=Asia/Kolkata
SITE_04_TIMEZONE=Asia/Kolkata
SITE_05_TIMEZONE=Asia/Kolkata
SITE_06_TIMEZONE=Asia/Kolkata
SITE_07_TIMEZONE=Asia/Kolkata
SITE_08_TIMEZONE=Asia/Kolkata
SITE_09_TIMEZONE=Asia/Kolkata
SITE_10_TIMEZONE=Asia/Kolkata
SITE_11_TIMEZONE=Asia/Kolkata
SITE_12_TIMEZONE=Asia/Kolkata
SITE_13_TIMEZONE=Asia/Kolkata
SITE_14_TIMEZONE=Asia/Kolkata
BP_POSTGRES_SSL_MODE=verify-full
BP_REDIS_CONTROL_ENDPOINT=rediss://replace-with-staging-control-redis:6379/0
BP_REDIS_BROKER_ENDPOINT=rediss://replace-with-staging-broker-redis:6379/0
BP_OPENSEARCH_ENDPOINT=https://replace-with-staging-opensearch
BP_MEDIA_BUCKET=replace-with-staging-private-media-bucket
BP_MEDIA_STAGING_PREFIX=staging/
BP_MEDIA_CDN_ORIGIN=https://media.staging.example.invalid
BP_SECURITY_STATE_TABLE=replace-with-staging-security-state
BP_VAULT_ADDR=https://vault.staging.example.invalid
BP_VAULT_ROLE=bp-staging
BP_SMTP_HOST=email-smtp.staging.example.invalid
BP_SMTP_PORT=587
BP_SERVICE_NAME=api
BP_HTTP_PORT=8080
BP_POSTGRES_POOL_MAX=20
BP_POSTGRES_SITE_CREDENTIAL_FILE=/run/secrets/bp/postgres-site
BP_POSTGRES_PLATFORM_CREDENTIAL_FILE=/run/secrets/bp/postgres-platform
BP_REDIS_CONTROL_PASSWORD_FILE=/run/secrets/bp/redis-control
BP_REDIS_BROKER_PASSWORD_FILE=/run/secrets/bp/redis-broker
BP_SMTP_CREDENTIAL_FILE=/run/secrets/bp/smtp
