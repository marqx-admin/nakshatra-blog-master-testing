# Serialize image builds on memory-constrained 8 GB hosts.
COMPOSE_PARALLEL_LIMIT=1

# Public URLs configured as Coolify service domains.
BP_ADMIN_ORIGIN=https://admin.example.com
BP_MEDIA_ORIGIN=https://media.example.com

# Production transactional email provider.
BP_SMTP_HOST=smtp.example.com
BP_SMTP_PORT=587
BP_SMTP_USERNAME=replace-with-smtp-user
BP_SMTP_PASSWORD=replace-with-smtp-password

# Generate with: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BP_LOCAL_ENVELOPE_KEY=replace-with-44-character-fernet-key
# Generate with: openssl rand -hex 32
BP_LOCAL_ENVELOPE_HMAC_KEY=replace-with-64-hex-characters

# Coolify recognizes SERVICE_* names and generates persistent values when they
# are not supplied. Keep the generated values after first deployment.
SERVICE_PASSWORD_64_POSTGRES=
SERVICE_PASSWORD_64_POSTGRES_SITE=
SERVICE_PASSWORD_64_POSTGRES_PLATFORM=
SERVICE_PASSWORD_64_REDIS_CONTROL=
SERVICE_PASSWORD_64_REDIS_BROKER=
SERVICE_PASSWORD_64_MINIO=
SERVICE_PASSWORD_64_SECURITY_STATE=
SERVICE_USER_MINIO=
